# Coordinator (M1) settings — copy to .env and fill in. Keep your existing .env if you have one.

# Source laptops' REST APIs (source_api.py). Token = the same value as in that laptop's .env.
VEHICLES_API_URL=http://<registration-laptop-IP>:5101
VEHICLES_API_TOKEN=
INSURANCE_API_URL=http://<insurance-laptop-IP>:5102
INSURANCE_API_TOKEN=
RTO_API_URL=http://<rto-laptop-IP>:5103
RTO_API_TOKEN=
THEFT_API_URL=http://<theft-laptop-IP>:5104
THEFT_API_TOKEN=
MOT_API_URL=http://<mot-host>:5105
MOT_API_TOKEN=

# MoT reporting (reporting.py / generate_report.py write to mot_db over MySQL)
MOT_HOST=
COORDINATOR_USER=
COORDINATOR_PASSWORD=
DB_PORT=3306

# Optional
# SOURCE_API_TIMEOUT_SEC=30
# SQL_CONSOLE_ALLOW_WRITES=false
