# Theft laptop (M5). Your existing .env (in IIA_Project_1/ or here) needs these lines:
THEFT_HOST=127.0.0.1
COORDINATOR_USER=coordinator
COORDINATOR_PASSWORD=
THEFT_API_TOKEN=            # IDENTICAL to THEFT_API_TOKEN in the coordinator's .env (8+ chars)
SOURCE_API_VERBOSE=true
PHASE3_DB_USER=root         # admin login used by gen_theft.py / setup_theft.py
PHASE3_DB_PASSWORD=
